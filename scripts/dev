#!/usr/bin/env bash
# Vibe-Research 开发编排脚本（参考 Vibe-Trading/scripts/dev，改用 uv 管理 Python）。
#
# 用 uv 在 backend/.venv 建虚拟环境 + 装 requirements.txt，再用 `uv run` 拉起 uvicorn；
# 前端走 npm。两者作为后台常驻进程托管，PID/日志落在 .vr-dev/ 下。
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${VR_DEV_STATE_DIR:-$ROOT/.vr-dev}"
LOG_DIR="$STATE_DIR/logs"
PID_DIR="$STATE_DIR/pids"

# 默认值贴合本项目：后端 127.0.0.1:8900（与 README / 安全默认一致），前端 0.0.0.0:5899（便于局域网调试）。
# 前端 vite 代理始终打到 http://127.0.0.1:<后端端口>（见 vite.config 的 IPv6 说明，issue #8）。
BACKEND_HOST="${VR_BACKEND_HOST:-127.0.0.1}"
BACKEND_PORT="${VR_BACKEND_PORT:-8900}"
FRONTEND_HOST="${VR_FRONTEND_HOST:-0.0.0.0}"
FRONTEND_PORT="${VR_FRONTEND_PORT:-5899}"

# uv 二进制，默认取 PATH 上的 uv；可用 VR_UV 覆盖（如自定义安装路径）。
VR_UV="${VR_UV:-uv}"

# backend 虚拟环境（与 README 约定一致：backend/.venv）。
BACKEND_VENV="$ROOT/backend/.venv"
BACKEND_REQ="$ROOT/backend/requirements.txt"

mkdir -p "$LOG_DIR" "$PID_DIR"

usage() {
  cat <<USAGE
Usage: scripts/dev <command>

Commands:
  up                 启动后端 + 前端开发服务器
  stop               停止本脚本启动的服务
  restart [service]  重启 backend / frontend / all（默认 all）
  status             查看进程状态与 URL
  logs [service]     跟踪 backend / frontend / all 的日志
  open               用默认浏览器打开前端
  urls               打印本地开发 URL

Environment:
  VR_BACKEND_HOST     后端监听地址（默认 127.0.0.1）
  VR_BACKEND_PORT     后端端口（默认 8900）
  VR_FRONTEND_HOST    前端监听地址（默认 0.0.0.0）
  VR_FRONTEND_PORT    前端端口（默认 5899）
  VR_UV               uv 可执行文件路径（默认 uv）
  VR_DEV_STATE_DIR    PID/日志目录（默认 <repo>/.vr-dev）
USAGE
}

# —— uv 前置检查 ——
require_uv() {
  if ! command -v "$VR_UV" >/dev/null 2>&1; then
    printf "未找到 uv（%s）。请先安装：https://docs.astral.sh/uv/getting-started/installation/\n" "$VR_UV" >&2
    exit 1
  fi
}

# —— 确保 backend/.venv 存在且依赖已安装（uv 建环境 + uv pip 装依赖）——
# 用 stamp 文件记录上次安装时间，仅在 venv 缺失或 requirements.txt 变更时重装，其余 up/restart 秒过。
ensure_backend_env() {
  if [[ ! -d "$BACKEND_VENV" ]]; then
    printf "creating uv venv at %s\n" "$BACKEND_VENV"
    "$VR_UV" venv "$BACKEND_VENV"
  fi
  local stamp="$BACKEND_VENV/.vr-deps-stamped"
  if [[ ! -f "$stamp" ]] || [[ "$BACKEND_REQ" -nt "$stamp" ]]; then
    printf "syncing backend deps via uv...\n"
    VIRTUAL_ENV="$BACKEND_VENV" "$VR_UV" pip install -r "$BACKEND_REQ"
    touch "$stamp"
  fi
}

pid_file() {
  printf "%s/%s.pid" "$PID_DIR" "$1"
}

log_file() {
  printf "%s/%s.log" "$LOG_DIR" "$1"
}

# url 健康探测回退用的 python（优先 backend/.venv 的，否则系统 python3）。
_url_python() {
  if [[ -x "$BACKEND_VENV/bin/python" ]]; then
    printf '%s' "$BACKEND_VENV/bin/python"
  else
    printf '%s' python3
  fi
}

is_running() {
  local service="$1"
  local file
  file="$(pid_file "$service")"
  [[ -f "$file" ]] && kill -0 "$(cat "$file")" 2>/dev/null
}

# 把一条命令作为新会话（独立进程组）的后台常驻进程拉起，便于后续按 PID/进程组管理。
start_service() {
  local service="$1"
  shift
  if is_running "$service"; then
    printf "%s already running (pid %s)\n" "$service" "$(cat "$(pid_file "$service")")"
    return
  fi

  printf "starting %s...\n" "$service"
  "$("_url_python")" - "$(log_file "$service")" "$(pid_file "$service")" "$@" <<'PY'
import subprocess
import sys

log_path = sys.argv[1]
pid_path = sys.argv[2]
cmd = sys.argv[3:]

log = open(log_path, "ab", buffering=0)
proc = subprocess.Popen(
    cmd,
    stdin=subprocess.DEVNULL,
    stdout=log,
    stderr=subprocess.STDOUT,
    start_new_session=True,
    close_fds=True,
)
with open(pid_path, "w", encoding="utf-8") as fh:
    fh.write(str(proc.pid))
PY
  printf "%s pid %s, log %s\n" "$service" "$(cat "$(pid_file "$service")")" "$(log_file "$service")"
}

stop_service() {
  local service="$1"
  local file
  file="$(pid_file "$service")"
  if ! [[ -f "$file" ]]; then
    printf "%s not started by scripts/dev\n" "$service"
    return
  fi

  local pid
  pid="$(cat "$file")"
  if kill -0 "$pid" 2>/dev/null; then
    printf "stopping %s (pid %s)...\n" "$service" "$pid"
    kill -TERM "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
    sleep 0.5
    kill -KILL "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$file"
}

url_ok() {
  local url="$1"
  if command -v curl >/dev/null 2>&1; then
    curl -fsS --max-time 2 "$url" >/dev/null 2>&1
  else
    "$("_url_python")" - "$url" >/dev/null 2>&1 <<'PY'
import sys
import urllib.request

urllib.request.urlopen(sys.argv[1], timeout=2).read(1)
PY
  fi
}

wait_for_url() {
  local service="$1"
  local url="$2"
  local attempts="${3:-30}"

  printf "waiting for %s at %s" "$service" "$url"
  for ((i = 1; i <= attempts; i++)); do
    if url_ok "$url"; then
      printf " ready\n"
      return 0
    fi
    if ! is_running "$service"; then
      printf "\n%s exited early; see %s\n" "$service" "$(log_file "$service")" >&2
      return 1
    fi
    printf "."
    sleep 1
  done
  printf "\n%s not ready after %ss; see %s\n" "$service" "$attempts" "$(log_file "$service")" >&2
  return 1
}

service_url() {
  case "$1" in
    backend) printf "http://127.0.0.1:%s/api/health" "$BACKEND_PORT" ;;
    frontend) printf "http://127.0.0.1:%s" "$FRONTEND_PORT" ;;
    *) return 2 ;;
  esac
}

start_backend() {
  if ! is_running backend && url_ok "$(service_url backend)"; then
    rm -f "$(pid_file backend)"
    printf "backend already reachable at %s (external)\n" "$(service_url backend)"
    return
  fi
  ensure_backend_env
  # uv run 会用 backend/.venv 里的解释器；cd 进 backend 是因为 app.py 用兄弟模块导入（import astock）。
  start_service backend bash -lc '
    set -euo pipefail
    cd "$1/backend"
    exec "$2" run python -m uvicorn app:app --host "$3" --port "$4"
  ' bash "$ROOT" "$VR_UV" "$BACKEND_HOST" "$BACKEND_PORT"
}

start_frontend() {
  if ! is_running frontend && url_ok "$(service_url frontend)"; then
    rm -f "$(pid_file frontend)"
    printf "frontend already reachable at %s (external)\n" "$(service_url frontend)"
    return
  fi
  # 后端始终以 127.0.0.1 对前端可达（vite 代理避免 localhost 的 IPv6 误解析，issue #8）。
  start_service frontend bash -lc '
    set -euo pipefail
    cd "$1"
    if ! [[ -d node_modules ]]; then
      npm install
    fi
    export VITE_API_URL="${VITE_API_URL:-http://127.0.0.1:$4}"
    exec npm run dev -- --host "$2" --port "$3"
  ' bash "$ROOT/frontend" "$FRONTEND_HOST" "$FRONTEND_PORT" "$BACKEND_PORT"
}

cmd_up() {
  require_uv
  start_backend
  start_frontend
  if ! wait_for_url backend "$(service_url backend)" 30 || \
     ! wait_for_url frontend "$(service_url frontend)" 30; then
    cmd_stop
    exit 1
  fi
  cmd_urls
}

cmd_stop() {
  stop_service frontend
  stop_service backend
}

cmd_restart() {
  local service="${1:-all}"
  case "$service" in
    backend)
      stop_service backend
      start_backend
      wait_for_url backend "$(service_url backend)" 30
      ;;
    frontend)
      stop_service frontend
      start_frontend
      wait_for_url frontend "$(service_url frontend)" 30
      ;;
    all)
      cmd_stop
      cmd_up
      ;;
    *)
      printf "unknown service: %s\n" "$service" >&2
      exit 2
      ;;
  esac
}

cmd_status() {
  for service in backend frontend; do
    if is_running "$service"; then
      printf "%-8s running pid=%s log=%s\n" "$service" "$(cat "$(pid_file "$service")")" "$(log_file "$service")"
    elif url_ok "$(service_url "$service")"; then
      printf "%-8s reachable external url=%s\n" "$service" "$(service_url "$service")"
    else
      printf "%-8s stopped\n" "$service"
    fi
  done
  cmd_urls
}

cmd_logs() {
  local service="${1:-all}"
  case "$service" in
    backend|frontend)
      touch "$(log_file "$service")"
      tail -f "$(log_file "$service")"
      ;;
    all)
      touch "$(log_file backend)" "$(log_file frontend)"
      tail -f "$(log_file backend)" "$(log_file frontend)"
      ;;
    *)
      printf "unknown service: %s\n" "$service" >&2
      exit 2
      ;;
  esac
}

cmd_open() {
  local url="http://127.0.0.1:$FRONTEND_PORT"
  if command -v open >/dev/null 2>&1; then
    open "$url"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url"
  else
    printf "%s\n" "$url"
  fi
}

cmd_urls() {
  cat <<URLS
Frontend: http://127.0.0.1:$FRONTEND_PORT
Backend:  http://127.0.0.1:$BACKEND_PORT/api/health
API docs: http://127.0.0.1:$BACKEND_PORT/docs
URLS
}

case "${1:-}" in
  up) cmd_up ;;
  stop) cmd_stop ;;
  restart) shift; cmd_restart "${1:-all}" ;;
  status) require_uv; cmd_status ;;
  logs) shift; cmd_logs "${1:-all}" ;;
  open) cmd_open ;;
  urls) cmd_urls ;;
  -h|--help|help|"") usage ;;
  *)
    printf "unknown command: %s\n\n" "$1" >&2
    usage >&2
    exit 2
    ;;
esac
