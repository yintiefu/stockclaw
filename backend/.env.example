# VibeResearch 后端可选配置。
# 本地自托管：全部留空即可（开箱开放）。公网部署：务必设置下面两项。
# 用法：复制为 .env，或直接 export 这些环境变量后再起服务。

# ── 安全（公网部署必设） ─────────────────────────────────────────────
# CORS 白名单，逗号分隔。默认 "*"（放开，适合本地）。公网收紧成你的前端域名：
#   VR_ALLOW_ORIGINS=https://your-frontend-host
VR_ALLOW_ORIGINS=*

# 鉴权 key。一旦设置，所有 /api/*（除 /api/health）都需带 Authorization: Bearer <key>。
# 本地留空=开放；公网部署务必设一个强随机值（否则别人能读你的持仓、调你的后端）：
#   VR_API_KEY=$(openssl rand -hex 32)
VR_API_KEY=

# ── 数据源（可选） ───────────────────────────────────────────────────
# 行情/研报/公告/资金面等零 key 即用；仅 iwencai 语义搜索研报需要 key：
# IWENCAI_API_KEY=
# IWENCAI_BASE_URL=https://openapi.iwencai.com

# 代理：默认不用管。东财等国内数据源**默认直连**（自动绕开你的科学上网/Clash 代理，
# 因为国内财经站走翻墙代理反而会连不上，如 push2.eastmoney.com）。
# 仅当你的机器「只能靠代理才能出网」时，才设为 1 强制走系统代理：
# VR_DATA_PROXY=1

# AI：无需在此配置。用户在网页「接入 AI」页填自己的 key（存本地浏览器），
#     或用订阅接入调本机已登录的 CLI（Claude Code / Codex / Qwen / Gemini / DeepSeek）。

# ── AI native agent 层（Phase 1 起） ─────────────────────────────────
# SQLite 路径（默认 backend/.cache/stockclaw.db，已 gitignore）。可改 ~/.stockclaw/stockclaw.db
VR_AGENT_DB=backend/.cache/stockclaw.db
# 默认主驾模型（用户在前端「接入 AI」里可覆盖）
VR_AGENT_MODEL=glm-5.2
# 主动 agent cron（Phase 3 生效，Phase 1 预留）
VR_AGENT_PROACTIVE_CRON=0 9 * * *
# plan-execute / 多 agent 最大轮数硬上限（Phase 2 生效）
VR_AGENT_MAX_ITERATIONS=8
# 东财 cool-down 秒数（Rate Limiter）
VR_AGENT_RATE_LIMIT_COOLDOWN=1.0
# 强缓存 TTL（秒，默认 30 分钟）
VR_AGENT_RATE_LIMIT_CACHE_TTL=1800
